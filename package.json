{
  "name": "spoons",
  "version": "0.1.0",
  "private": true,
  "description": "Spoons card game: a shared TV screen plus a phone for each player's hand",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "express": "^5.1.0",
    "machina": "^8.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "concurrently": "^9.2.0",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.1",
    "svelte": "^5.38.0",
    "vite": "^7.1.0"
  }
}
